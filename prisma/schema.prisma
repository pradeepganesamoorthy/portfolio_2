generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id          String    @id @default(cuid())
  section     String
  key         String
  draftValue  Json
  liveValue   Json?
  isDraft     Boolean   @default(true)
  order       Int       @default(0)
  visible     Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@unique([section, key])
  @@index([section])
}

model GithubConfig {
  id            String   @id @default(cuid())
  username      String
  pinnedOnly    Boolean  @default(false)
  excludeRepos  String[] @default([])
  featuredRepos String[] @default([])
  sortBy        String   @default("updated")
  showLanguage  Boolean  @default(true)
  showStars     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model ResumeFile {
  id          String   @id @default(cuid())
  filename    String
  path        String
  mimeType    String
  isPublished Boolean  @default(false)
  uploadedAt  DateTime @default(now())
}

model ProfileImage {
  id         String   @id @default(cuid())
  filename   String
  path       String
  type       String
  uploadedAt DateTime @default(now())
}

model Video {
  id            String   @id @default(cuid())
  title         String
  url           String
  type          String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  description   String?
  youtubeUrl    String?
  youtubeId     String?
  projectName   String?
  order         Int      @default(0)
  visible       Boolean  @default(true)
  showInGallery Boolean  @default(true)
  isDraft       Boolean  @default(false)
}

model VideoConfig {
  id           String  @id @default(cuid())
  enabled      Boolean @default(true)
  autoplay     Boolean @default(false)
  showControls Boolean @default(true)
}

model ThemeConfig {
  id                String   @id @default(cuid())
  primaryColor      String   @default("#c77dff")
  secondaryColor    String   @default("#4d96ff")
  accentColor       String   @default("#ff6b6b")
  navbarBgColor     String   @default("rgba(0,0,0,0.8)")
  textColor         String   @default("#ffffff")
  hoverColor        String   @default("#ffd93d")
  themePreset       String   @default("custom")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  sectionFontColors String   @default("{}")
}

model AnimationConfig {
  id                String   @id @default(cuid())
  selectedAnimation String   @default("particles-torus")
  animationSpeed    String   @default("normal")
  useThemeColors    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

model Badge {
  id          String   @id @default(cuid())
  section     String
  name        String
  type        String   @default("preset")
  iconName    String?
  customImage String?
  color       String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([section])
  @@index([order])
}
