# PostgreSQL connection string
# For local: postgresql://postgres:password@localhost:5432/portfolio
# For Supabase: find in Project Settings > Database > Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT Secret - generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"

# Optional: GitHub Personal Access Token for higher API rate limits
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=""

# Optional: For contact form email delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
CONTACT_RECIPIENT="pradeepganesh111@gmail.com"
